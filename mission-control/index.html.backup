<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mission Control</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0d1117; color: #c9d1d9; height: 100vh; overflow: hidden; }
        .container { display: flex; height: 100vh; }
        .sidebar { width: 220px; background: #161b22; border-right: 1px solid #30363d; padding: 20px 0; }
        .logo { padding: 0 20px 20px; font-weight: 600; font-size: 14px; color: #58a6ff; border-bottom: 1px solid #30363d; margin-bottom: 10px; }
        .nav-item { padding: 8px 20px; cursor: pointer; font-size: 13px; color: #8b949e; }
        .nav-item:hover { background: #21262d; color: #c9d1d9; }
        .nav-item.active { background: #21262d; color: #58a6ff; border-left: 2px solid #58a6ff; }
        .main-content { flex: 1; display: flex; flex-direction: column; }
        .header { height: 50px; background: #161b22; border-bottom: 1px solid #30363d; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; }
        .header-title { font-size: 14px; font-weight: 500; }
        .token-sentry { display: flex; align-items: center; gap: 10px; background: #0d1117; padding: 6px 12px; border-radius: 6px; border: 1px solid #30363d; }
        .token-gauge { display: flex; align-items: center; gap: 6px; }
        .gauge-bar { width: 60px; height: 8px; background: #21262d; border-radius: 4px; overflow: hidden; }
        .gauge-fill { height: 100%; background: #3fb950; transition: width 0.3s, background 0.3s; border-radius: 4px; }
        .gauge-fill.warning { background: #d29922; }
        .gauge-fill.danger { background: #f85149; animation: flash 0.5s infinite; }
        @keyframes flash { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .token-count { font-size: 12px; color: #8b949e; min-width: 60px; }
        .purge-btn { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 4px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; }
        .purge-btn:hover { background: #30363d; color: #c9d1d9; }
        .purge-btn.danger:hover { background: #da3633; color: white; }
        .view-section { flex: 1; padding: 20px; display: none; overflow-y: auto; }
        .view-section.active { display: block; }
        .dashboard-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; }
        .card-title { font-size: 12px; color: #8b949e; margin-bottom: 12px; }
        .card-value { font-size: 24px; font-weight: 600; }
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: none; align-items: center; justify-content: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 20px; max-width: 400px; }
    
        /* Key Vault styles */
        .key-list { display: grid; gap: 12px; }
        .key-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 12px 16px;
        }
        .key-name { font-size: 13px; font-weight: 500; }
        .key-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 4px;
        }
        .key-status.active {
            background: #1a3a2a;
            color: #3fb950;
            border: 1px solid #3fb950;
        }
        .key-status.expired {
            background: #3a1a1a;
            color: #f85149;
            border: 1px solid #f85149;
            animation: pulse 1s infinite;
        }
        .key-status.warning {
            background: #3a2a1a;
            color: #d29922;
            border: 1px solid #d29922;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .key-vault-alert {
            background: #3a1a1a;
            border: 1px solid #f85149;
            color: #f85149;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            display: none;
        }
        .key-vault-alert.show { display: block; }
        /* Gateway Status styles */
        .status-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .status-card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 16px;
        }
        .status-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }
        .status-name { font-size: 13px; font-weight: 500; color: #8b949e; }
        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #30363d;
        }
        .status-indicator.online { background: #3fb950; box-shadow: 0 0 8px #3fb950; }
        .status-indicator.offline { background: #f85149; box-shadow: 0 0 8px #f85149; animation: blink 1s infinite; }
        .status-indicator.warning { background: #d29922; box-shadow: 0 0 8px #d29922; }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .status-details { font-size: 11px; color: #8b949e; }
        .error-log {
            background: #0d1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 12px;
            font-family: monospace;
            font-size: 11px;
            max-height: 200px;
            overflow-y: auto;
        }
        .error-log .error { color: #f85149; }
        .error-log .warning { color: #d29922; }
        .error-log .success { color: #3fb950; }</style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="logo">Mission Control</div>
            <div class="nav-item active" data-view="dashboard">Dashboard</div>
            <div class="nav-item" data-view="tasks">Task Board</div>
            <div class="nav-item" data-view="memory">Daily Memory</div>
            <div class="nav-item" data-view="longterm">Long-Term Memory</div>
            <div class="nav-item" data-view="prd-generator">PRD Generator</div>
                                    <div class="nav-item" data-view="gateway-status">Gateway Status</div>
            <div class="nav-item" data-view="key-vault">Key Vault</div>
            <div class="nav-item" data-view="custom-tools">Custom Tools</div>
        </div>
        <div class="main-content">
            <div class="header">
                <div class="header-title" id="view-title">Dashboard</div>
                <div class="token-sentry">
                    <div class="token-gauge">
                        <div class="gauge-bar">
                            <div class="gauge-fill" id="token-fill" style="width: 45%"></div>
                        </div>
                        <div class="token-count" id="token-count">4,521 / 10,000</div>
                    </div>
                    <button class="purge-btn" id="purge-btn" onclick="purgeContext()">Purge Context</button>
                </div>
            </div>
            <div class="view-section active" id="dashboard-view">
                <div class="dashboard-grid">
                    <div class="card"><div class="card-title">Token Usage</div><div class="card-value" id="dash-token-count">4,521</div></div>
                    <div class="card"><div class="card-title">Messages</div><div class="card-value" id="dash-message-count">12</div></div>
                    <div class="card"><div class="card-title">Context Depth</div><div class="card-value" id="dash-context-depth">3</div></div>
                </div>
            </div>
            <div class="view-section" id="tasks-view"><h2>Task Board</h2><p>Coming soon...</p></div>
            <div class="view-section" id="memory-view"><h2>Daily Memory</h2><p>Coming soon...</p></div>
            <div class="view-section" id="longterm-view"><h2>Long-Term Memory</h2><p>Coming soon...</p></div>
            <div class="view-section" id="prd-generator-view"><h2>PRD Generator</h2><p>Coming soon...</p></div>
                                    <div class="view-section" id="gateway-status-view">
                <h2>Gateway Status</h2>
                <p style="color: #8b949e; margin-bottom: 20px;">Monitor OpenClaw gateway health and connection status</p>
                
                <div class="status-grid">
                    <div class="status-card">
                        <div class="status-header">
                            <span class="status-name">OpenClaw Gateway</span>
                            <div class="status-indicator" id="gateway-indicator"></div>
                        </div>
                        <div class="status-details" id="gateway-details">Checking...</div>
                    </div>
                    <div class="status-card">
                        <div class="status-header">
                            <span class="status-name">WhatsApp Connection</span>
                            <div class="status-indicator" id="whatsapp-indicator"></div>
                        </div>
                        <div class="status-details" id="whatsapp-details">Checking...</div>
                    </div>
                    <div class="status-card">
                        <div class="status-header">
                            <span class="status-name">Telegram Connection</span>
                            <div class="status-indicator" id="telegram-indicator"></div>
                        </div>
                        <div class="status-details" id="telegram-details">Checking...</div>
                    </div>
                    <div class="status-card">
                        <div class="status-header">
                            <span class="status-name">System Health</span>
                            <div class="status-indicator" id="health-indicator"></div>
                        </div>
                        <div class="status-details" id="health-details">Checking...</div>
                    </div>
                </div>
                
                <h3 style="font-size: 13px; color: #8b949e; margin-bottom: 12px;">Recent Activity / Errors</h3>
                <div class="error-log" id="error-log">
                    <div class="success">? Gateway started successfully</div>
                </div>
                
                <div style="margin-top: 20px;">
                    <button class="btn btn-secondary" onclick="refreshGatewayStatus()">Refresh Status</button>
                    <button class="btn btn-secondary" onclick="restartGateway()" style="margin-left: 10px;">Restart Gateway</button>
                </div>
            </div>`n            <div class="view-section" id="key-vault-view">
                <h2>Key Vault</h2>
                <p style="color: #8b949e; margin-bottom: 20px;">Monitor API key status and prevent authentication failures</p>
                
                <div class="key-vault-alert" id="key-vault-alert">
                    <strong>?? Key Alert:</strong> <span id="alert-message"></span>
                </div>
                
                <div class="key-list" id="key-list">
                    <!-- Keys will be populated by JavaScript -->
                </div>
                
                <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #30363d;">
                    <h3 style="font-size: 13px; color: #8b949e; margin-bottom: 12px;">Status Legend</h3>
                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div class="key-status active">? Active</div>
                        <div class="key-status warning">? Expiring Soon</div>
                        <div class="key-status expired">? Expired</div>
                    </div>
                </div>
            </div>`n            <div class="view-section" id="custom-tools-view"><h2>Custom Tools</h2><p>Coming soon...</p></div>
        </div>
    </div>
    <div class="modal-overlay" id="purge-modal">
        <div class="modal">
            <h3>Purge Context?</h3>
            <p>Clear current lane and reset tokens to ~1,000. This cannot be undone.</p>
            <button class="purge-btn" id="confirm-purge" style="background:#da3633;color:white;">Purge Context</button>
            <button class="purge-btn" id="cancel-purge">Cancel</button>
        </div>
    </div>
    <script>
        document.querySelectorAll('.nav-item').forEach(item => {
            item.addEventListener('click', function() {
                document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                const view = this.dataset.view;
                document.getElementById('view-title').textContent = this.textContent;
                document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));
                document.getElementById(view + '-view').classList.add('active');
            });
        });
        
        let tokenState = { currentTokens: 4521, maxTokens: 10000, warningThreshold: 8000, dangerThreshold: 10000, messages: 12, contextDepth: 3 };
        
        function updateTokenDisplay() {
            const percentage = (tokenState.currentTokens / tokenState.maxTokens) * 100;
            document.getElementById('token-fill').style.width = percentage + '%';
            document.getElementById('token-count').textContent = tokenState.currentTokens.toLocaleString() + ' / ' + tokenState.maxTokens.toLocaleString();
            document.getElementById('dash-token-count').textContent = tokenState.currentTokens.toLocaleString();
            document.getElementById('dash-message-count').textContent = tokenState.messages;
            document.getElementById('dash-context-depth').textContent = tokenState.contextDepth;
            const fill = document.getElementById('token-fill');
            fill.classList.remove('warning', 'danger');
            if (tokenState.currentTokens >= tokenState.dangerThreshold) fill.classList.add('danger');
            else if (tokenState.currentTokens >= tokenState.warningThreshold) fill.classList.add('warning');
        }
        
        function purgeContext() {
            document.getElementById('purge-modal').classList.add('active');
        }
        
        document.getElementById('confirm-purge').addEventListener('click', function() {
            tokenState.currentTokens = 1000; tokenState.messages = 0; tokenState.contextDepth = 1;
            updateTokenDisplay();`n        `n        // Initialize Key Vault`n        updateKeyVault();`n        `n        // Initialize Gateway Status`n        updateGatewayStatus();
            document.getElementById('purge-modal').classList.remove('active');
        });
        
        document.getElementById('cancel-purge').addEventListener('click', function() {
            document.getElementById('purge-modal').classList.remove('active');
        });
        
        document.getElementById('purge-modal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('active');
        });
        
        updateTokenDisplay();`n        `n        // Initialize Key Vault`n        updateKeyVault();`n        `n        // Initialize Gateway Status`n        updateGatewayStatus();
    
        // Key Vault - API Key Monitoring
        const keyVault = {
            keys: [
                { name: 'OPENROUTER_API_KEY', status: 'active', expires: null },
                { name: 'BRAVE_SEARCH_API_KEY', status: 'active', expires: null },
                { name: 'TELEGRAM_BOT_TOKEN', status: 'active', expires: null },
                { name: 'GROQ_API_KEY', status: 'warning', expires: '2026-05-15' },
                { name: 'GOOGLE_CLOUD_KEY', status: 'expired', expires: '2026-03-01' }
            ]
        };

        function updateKeyVault() {
            const keyList = document.getElementById('key-list');
            const alertBox = document.getElementById('key-vault-alert');
            const alertMessage = document.getElementById('alert-message');
            let hasExpired = false;
            let expiredKeys = [];

            keyList.innerHTML = keyVault.keys.map(key => {
                const statusClass = key.status === 'active' ? 'active' : key.status === 'warning' ? 'warning' : 'expired';
                const statusText = key.status === 'active' ? 'Active' : key.status === 'warning' ? 'Expiring Soon' : 'Expired';
                
                if (key.status === 'expired') {
                    hasExpired = true;
                    expiredKeys.push(key.name);
                }
                
                return `
                    <div class="key-item">
                        <div class="key-name">${key.name}</div>
                        <div class="key-status ${statusClass}">
                            <span>?</span> ${statusText}
                            ${key.expires ? `<span style="opacity:0.7">(${key.expires})</span>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            // Show alert if any keys are expired
            if (hasExpired) {
                alertBox.classList.add('show');
                alertMessage.textContent = `Expired keys detected: ${expiredKeys.join(', ')}. Update keys to prevent gateway failures.`;
            } else {
                alertBox.classList.remove('show');
            }
        }

        // Initialize key vault on load
        updateKeyVault();`n        `n        // Initialize Gateway Status`n        updateGatewayStatus();`n        `n        // Initialize Key Vault`n        updateKeyVault();`n        `n        // Initialize Gateway Status`n        updateGatewayStatus();`n    
        // Gateway Status Monitoring
        const gatewayState = {
            gateway: { online: true, lastCheck: Date.now() },
            whatsapp: { online: true, errors: 0 },
            telegram: { online: true, errors: 0 },
            health: { status: 'good', uptime: '2h 34m' }
        };

        function updateGatewayStatus() {
            // Simulate status check (in real implementation, would poll actual gateway)
            const now = Date.now();
            
            // Update indicators based on state
            setIndicator('gateway-indicator', gatewayState.gateway.online ? 'online' : 'offline');
            setIndicator('whatsapp-indicator', gatewayState.whatsapp.online ? 'online' : (gatewayState.whatsapp.errors > 0 ? 'warning' : 'offline'));
            setIndicator('telegram-indicator', gatewayState.telegram.online ? 'online' : 'offline');
            setIndicator('health-indicator', gatewayState.health.status === 'good' ? 'online' : 'warning');
            
            // Update details
            document.getElementById('gateway-details').textContent = gatewayState.gateway.online ? 'Running on port 3000' : 'Not responding';
            document.getElementById('whatsapp-details').textContent = gatewayState.whatsapp.online ? 'Connected' : `Errors: ${gatewayState.whatsapp.errors}`;
            document.getElementById('telegram-details').textContent = gatewayState.telegram.online ? 'Connected' : 'Disconnected';
            document.getElementById('health-details').textContent = `Uptime: ${gatewayState.health.uptime}`;
        }

        function setIndicator(id, status) {
            const el = document.getElementById(id);
            el.className = 'status-indicator ' + status;
        }

        function refreshGatewayStatus() {
            const log = document.getElementById('error-log');
            const time = new Date().toLocaleTimeString();
            log.innerHTML = `<div class="success">[${time}] Refreshing status...</div>` + log.innerHTML;
            
            // Simulate status refresh
            setTimeout(() => {
                gatewayState.whatsapp.errors = Math.random() > 0.7 ? Math.floor(Math.random() * 3) : 0;
                updateGatewayStatus();
                log.innerHTML = `<div class="success">[${time}] Status refreshed</div>` + log.innerHTML;
            }, 500);
        }

        function restartGateway() {
            const log = document.getElementById('error-log');
            const time = new Date().toLocaleTimeString();
            log.innerHTML = `<div class="warning">[${time}] Restarting gateway...</div>` + log.innerHTML;
            
            // Simulate restart
            setTimeout(() => {
                gatewayState.gateway.online = true;
                gatewayState.whatsapp.online = true;
                gatewayState.telegram.online = true;
                updateGatewayStatus();
                log.innerHTML = `<div class="success">[${time}] Gateway restarted successfully</div>` + log.innerHTML;
            }, 1500);
        }`n    </script>
</body>
</html>








